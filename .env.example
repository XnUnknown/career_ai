# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# Never commit .env.local (it's in .gitignore) — it contains your API key.

# ===== Ollama (Member 2 — AI module) =====
# Local Ollama server (default):
#   OLLAMA_HOST=http://localhost:11434   → no key needed
# Ollama Cloud (hosted inference):
#   OLLAMA_HOST=https://ollama.com       → requires OLLAMA_API_KEY below
OLLAMA_HOST=https://ollama.com

# API key from https://ollama.com/settings/keys (only needed for cloud).
# Leave empty for local Ollama.
# OLLAMA_API_KEY=

# Model used for recommendations.
# Local:   pull it first (e.g. `ollama pull llama3.1`).
# Cloud:   any model on your account, WITHOUT the `-cloud` suffix
#          (e.g. gemma4:31b, glm-5.3-flash, kimi-k2.6, gpt-oss:120b).
OLLAMA_MODEL=gemma4:31b

# ===== Rate limiting (Member 2 — in-memory, per IP, per process) =====
# Max tokens (requests) a client can burst before being throttled
RATE_LIMIT_MAX=30
# How many tokens refill per minute
RATE_LIMIT_REFILL_PER_MINUTE=15

# ===== Web tools (Member 3) — add your search API key here =====
# TAVILY_API_KEY=...
# SERPAPI_API_KEY=...
# BRAVE_SEARCH_API_KEY=...
